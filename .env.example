# ---------------------------------------------------------------------------
# PLANTILLA DE CONFIGURACION
#
# 1. Copie este archivo:      cp .env.example .env
# 2. Cambie TODOS los valores que dicen "cambiar".
# 3. Nunca suba el archivo .env al repositorio (ya esta en .gitignore).
#
# Para generar claves aleatorias:
#   python -c "import secrets; print(secrets.token_hex(32))"
# ---------------------------------------------------------------------------

# --- Base de datos ---------------------------------------------------------
MYSQL_ROOT_PASSWORD=cambiar-clave-root-mysql
DB_USER=asilo
DB_PASSWORD=cambiar-clave-usuario-tecnico

# --- Seguridad de la aplicacion (minimo 32 caracteres cada una) -------------
SECRET_KEY=cambiar-por-64-caracteres-aleatorios-0000000000000000000000000000
API_KEY_SERVICIOS=cambiar-por-64-caracteres-aleatorios-1111111111111111111111111

# --- Claves temporales de los usuarios de prueba ---------------------------
# Se usan solo la primera vez que arranca el sistema. Cada usuario debe
# cambiar su clave en el primer ingreso (minimo 10 caracteres, letras y numeros).
CLAVE_INICIAL_ADMIN=cambiar-Admin-2026
CLAVE_INICIAL_USUARIOS=cambiar-Usuario-2026

# --- Despliegue --------------------------------------------------------------
PUERTO_APP=8000
# true solo cuando el sistema este publicado detras de HTTPS.
HTTPS=false

# --- Correo (opcional) -----------------------------------------------------
# Sin estos datos, los correos se registran con estado SIMULADA.
# Con Gmail se usa una "contrasena de aplicacion", no la clave de la cuenta.
SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_PASSWORD=
CORREO_REMITENTE=
